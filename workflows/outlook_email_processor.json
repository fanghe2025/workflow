{
  "name": "Outlook Email Processor with ML Labeling",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "options": {
          "allowAttachments": true,
          "downloadAttachments": true
        }
      },
      "id": "outlook-trigger",
      "name": "Outlook Trigger",
      "type": "n8n-nodes-base.microsoftOutlookTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "1",
          "name": "Outlook OAuth2"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-attachments",
              "leftValue": "={{ $json.hasAttachments }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-attachments",
      "name": "Check Has Attachments",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Get all attachments for the email\nconst email = $input.item.json;\nconst attachments = email.attachments || [];\n\n// Return array of attachment items to process\nreturn attachments.map(att => ({\n  emailId: email.id,\n  attachmentId: att.id,\n  attachmentName: att.name,\n  contentType: att.contentType,\n  size: att.size,\n  emailData: email\n}));"
      },
      "id": "prepare-attachments",
      "name": "Prepare Attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 200]
    },
    {
      "parameters": {
        "operation": "getAttachment",
        "messageId": "={{ $json.emailId }}",
        "attachmentId": "={{ $json.attachmentId }}"
      },
      "id": "get-attachment",
      "name": "Get Attachment",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 1,
      "position": [850, 200],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "1",
          "name": "Outlook OAuth2"
        }
      }
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $json.attachmentName }}",
        "dataPropertyName": "contentBytes",
        "options": {
          "folder": "data/attachments/{{ $json.emailData.id }}"
        }
      },
      "id": "save-attachment",
      "name": "Save Attachment",
      "type": "n8n-nodes-base.writeFile",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate all processed attachments back to email\nconst emailData = $('Prepare Attachments').first().json.emailData;\nconst attachmentItems = $input.all();\n\n// Build attachment info with file paths\nconst processedAttachments = attachmentItems.map(item => ({\n  id: item.json.attachmentId,\n  name: item.json.attachmentName,\n  contentType: item.json.contentType,\n  size: item.json.size,\n  file_path: `data/attachments/${emailData.id}/${item.json.attachmentName}`\n}));\n\nemailData.attachments = processedAttachments;\n\nreturn emailData;"
      },
      "id": "aggregate-attachments",
      "name": "Aggregate Attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "jsCode": "// Process email and prepare for ML\nconst email = $input.item.json;\n\n// Extract email data\nconst processedEmail = {\n  id: email.id || email.emailId,\n  subject: email.subject || '',\n  from: email.from?.emailAddress?.address || email.sender?.emailAddress?.address || '',\n  to: email.toRecipients?.map(r => r.emailAddress?.address) || [],\n  body: email.bodyPreview || email.body?.content || email.bodyText || '',\n  receivedDateTime: email.receivedDateTime,\n  hasAttachments: email.hasAttachments || false,\n  attachments: email.attachments || [],\n  importance: email.importance || 'normal',\n  categories: email.categories || []\n};\n\n// If attachments were processed, include their file paths\nif (email.attachments && email.attachments.length > 0) {\n  processedEmail.attachments = email.attachments.map(att => ({\n    id: att.id || att.attachmentId,\n    name: att.name || att.attachmentName,\n    contentType: att.contentType,\n    size: att.size,\n    file_path: att.file_path || `data/attachments/${processedEmail.id}/${att.name || att.attachmentName}`\n  }));\n}\n\nreturn processedEmail;"
      },
      "id": "process-email",
      "name": "Process Email Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 400]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ 'email_' + $json.id.replace(/[^a-zA-Z0-9]/g, '_') + '_' + Date.now() + '.json' }}",
        "dataPropertyName": "data",
        "options": {
          "folder": "data/processed_emails"
        }
      },
      "id": "save-email",
      "name": "Save Email Data",
      "type": "n8n-nodes-base.writeFile",
      "typeVersion": 1,
      "position": [850, 400]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/predict",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "predict-label",
      "name": "Predict Label (ML API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 400],
      "notes": "Calls ML API to predict email label"
    },
    {
      "parameters": {
        "jsCode": "// Add predicted label to email data\nconst email = $input.item.json;\nconst predictionResponse = $('Predict Label (ML API)').item.json;\n\n// Handle both success and error cases\nif (predictionResponse.error) {\n  email.predictedLabel = 'error';\n  email.confidence = 0;\n  email.predictionError = predictionResponse.error;\n} else {\n  email.predictedLabel = predictionResponse.label || 'unlabeled';\n  email.confidence = predictionResponse.confidence || 0;\n  email.allProbabilities = predictionResponse.all_probabilities || {};\n}\n\nreturn email;"
      },
      "id": "add-label",
      "name": "Add Predicted Label",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "operation": "update",
        "messageId": "={{ $json.id }}",
        "updateFields": {
          "categories": "={{ [$json.predictedLabel] }}"
        }
      },
      "id": "update-category",
      "name": "Update Email Category",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 1,
      "position": [1450, 400],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "1",
          "name": "Outlook OAuth2"
        }
      },
      "disabled": true,
      "notes": "Disabled by default. Enable to auto-categorize emails in Outlook."
    }
  ],
  "connections": {
    "Outlook Trigger": {
      "main": [
        [
          {
            "node": "Check Has Attachments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Has Attachments": {
      "main": [
        [
          {
            "node": "Prepare Attachments",
            "type": "main",
            "index": 0
          },
          {
            "node": "Process Email Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Attachments": {
      "main": [
        [
          {
            "node": "Get Attachment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Attachment": {
      "main": [
        [
          {
            "node": "Save Attachment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Attachment": {
      "main": [
        [
          {
            "node": "Aggregate Attachments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Attachments": {
      "main": [
        [
          {
            "node": "Process Email Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Email Data": {
      "main": [
        [
          {
            "node": "Save Email Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Email Data": {
      "main": [
        [
          {
            "node": "Predict Label (ML API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Predict Label (ML API)": {
      "main": [
        [
          {
            "node": "Add Predicted Label",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add Predicted Label": {
      "main": [
        [
          {
            "node": "Update Email Category",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2024-01-01T00:00:00.000Z",
