{
  "model": {
    "type": "lightgbm",
    "n_estimators": 300,
    "max_depth": 8,
    "learning_rate": 0.05,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "min_child_weight": 3,
    "gamma": 0.1,
    "reg_alpha": 0.1,
    "reg_lambda": 1.0,
    "random_state": 42
  },
  "vectorizer": {
    "max_features": 20000,
    "subject_max_features": 5000,
    "ngram_range": [1, 3],
    "min_df": 2,
    "max_df": 0.95
  },
  "training": {
    "test_size": 0.2,
    "random_state": 42,
    "use_cross_validation": true,
    "cv_folds": 5
  },
  "prediction": {
    "threshold": 0.4
  },
  "paths": {
    "labeled_data": "data/labeled_emails.json",
    "db_path": "data/emails.duckdb",
    "model_output": "models/email_classifier.pkl"
  },
  "attachment_processing": {
    "enabled": false,
    "max_file_size_mb": 10,
    "supported_formats": [
      "pdf",
      "docx",
      "doc",
      "txt",
      "xlsx",
      "xls"
    ],
    "extract_text_from_images": false
  }
}
